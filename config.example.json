{
  "codexPath": "codex",
  "transport": "daemon",
  "claude": {
    "path": "claude",
    "permissionMode": "acceptEdits"
  },
  "minFreeMemGb": 2,
  "maxCpuPct": 90,
  "pauseAtPct": {
    "claude": null,
    "codex": 95
  },
  "defaults": {
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "model": null,
    "effort": null
  },
  "watchIntervalMin": 30,
  "pollSec": 5,
  "stopWhenStuckMin": 120,
  "profiles": {
    "design": {
      "description": "設計・方式の検討（API・データ構造・画面の構成を決める。1〜2ファイルで済む小さな修正は除く）",
      "claude": {
        "model": "opus",
        "effort": "xhigh"
      },
      "codex": {
        "effort": "xhigh"
      }
    },
    "debug": {
      "description": "原因の分からない不具合の調査（1回で原因が絞れなければ effort を xhigh に上げる）",
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "codex": {
        "effort": "high"
      }
    },
    "implement": {
      "description": "ふつうの実装・修正",
      "claude": {
        "model": "opus",
        "effort": "medium"
      },
      "codex": {
        "effort": "medium"
      }
    },
    "review": {
      "description": "コードレビュー",
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "codex": {
        "effort": "high"
      }
    },
    "writing": {
      "description": "人が読む文章の作成・修正（ドキュメント・画面の文言）",
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "effort": "high"
      }
    },
    "routine": {
      "description": "手順の決まった作業・確認（画面の確認・定型の修正・調べものの要約）",
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "codex": {
        "effort": "medium"
      }
    }
  }
}
